@page "/"
@inject IChatClient ChatClient
@rendermode InteractiveServer

<PageTitle>Local LLM Chat</PageTitle>

<h1>Local LLM Chat</h1>

<div style="height: 400px; overflow-y: auto; border: 1px solid #ccc; padding: 1rem; margin-bottom: 1rem;">
    @foreach (var msg in history)
    {
        <p><strong>@(msg.Role == ChatRole.User ? "You" : "AI"):</strong> @msg.Text</p>
    }
</div>

<input @bind="input" @bind:event="oninput" @onkeyup="HandleKeyUp" disabled="@busy" style="width: 80%;" placeholder="Ask something..." />
<button @onclick="SendAsync" disabled="@(busy || string.IsNullOrWhiteSpace(input))">Send</button>

@code {
    private string input = string.Empty;
    private bool busy;
    private List<ChatMessage> history = new();

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(input) || busy) return;

        history.Add(new ChatMessage(ChatRole.User, input));
        input = string.Empty;
        busy = true;

        try
        {
            var response = await ChatClient.GetResponseAsync(history);
            history.AddRange(response.Messages);
        }
        catch (Exception ex)
        {
            history.Add(new ChatMessage(ChatRole.Assistant, $"Error: {ex.Message}"));
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendAsync();
    }
}